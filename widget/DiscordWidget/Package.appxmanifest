<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- THIS IS NOT THE SHIPPED MANIFEST.

       The package that users install is built by packaging\DiscordXboxWidget, and its
       manifest is the one that declares the Game Bar widgets, the app service, the
       full-trust bridge and the proxy/stub registrations. This file exists only because a
       UWP project cannot build without a manifest of its own, and it is deliberately kept
       to the minimum needed for that.

       Do not add package features here. Anything declared in this file is ignored at
       install time, so a feature added here and not to the packaging project's manifest
       would appear to work at build time and be absent from the product. -->

  <!-- Deliberately NOT the shipped identity. Deploying this project on its own would
       otherwise replace the installed package with a copy that has no bridge in it and no
       Game Bar registration, which breaks the real install in a way that is tedious to
       diagnose. A separate identity keeps a stray F5 harmless. -->
  <Identity
    Name="DiscordXboxWidget.WidgetProjectOnly"
    Publisher="CN=Terry Ellison, E=ellisonterry4@gmail.com"
    Version="0.1.2.0" />

  <mp:PhoneIdentity PhoneProductId="6f3d9a21-4c7e-4b2a-9e51-8b0c7d5a1e44" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Discord Voice for Game Bar (widget project)</DisplayName>
    <PublisherDisplayName>Terry Ellison</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="DiscordWidget.App">
      <uap:VisualElements
        DisplayName="Discord Voice"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Discord voice channel controls inside Xbox Game Bar"
        BackgroundColor="#5865F2"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- internetClient only. runFullTrust belongs to the packaging project's manifest: it is
       a restricted capability, and declaring it here is what emitted APPX0006. -->
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>

</Package>
