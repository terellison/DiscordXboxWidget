<Page
    x:Class="DiscordWidget.VoiceWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DiscordWidget"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind ViewModel.ChannelName, Mode=OneWay}"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                   Visibility="{x:Bind HasText(ViewModel.Status), Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0" />

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Participants}"
                  SelectionMode="None"
                  Margin="0,8,0,0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="38" />
                    <Setter Property="Padding" Value="4,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ParticipantViewModel">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar with the speaking ring drawn around it, both in one
                             fixed-size cell so the row never reflows as people talk. -->
                        <Grid Grid.Column="0" Width="28" Height="28">
                            <Ellipse Width="28" Height="28"
                                     Stroke="{StaticResource SpeakingBrush}"
                                     StrokeThickness="2"
                                     Opacity="{x:Bind SpeakingOpacity, Mode=OneWay}" />
                            <Ellipse Width="22" Height="22">
                                <Ellipse.Fill>
                                    <ImageBrush Stretch="UniformToFill">
                                        <ImageBrush.ImageSource>
                                            <BitmapImage UriSource="{x:Bind AvatarUri}"
                                                         DecodePixelWidth="44"
                                                         DecodePixelHeight="44" />
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="{x:Bind SelfWeight}" />

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind StateGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button Content="{x:Bind MuteLabel(ViewModel.IsMuted), Mode=OneWay}"
                    Click="OnToggleMute"
                    IsEnabled="{x:Bind ViewModel.CanControlVoice, Mode=OneWay}" />
            <Button Content="{x:Bind DeafenLabel(ViewModel.IsDeafened), Mode=OneWay}"
                    Click="OnToggleDeafen"
                    IsEnabled="{x:Bind ViewModel.CanControlVoice, Mode=OneWay}" />
            <Button Content="Leave"
                    Click="OnLeave"
                    IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}"
                    Visibility="{x:Bind Visible(ViewModel.IsInVoice), Mode=OneWay}" />
            <Button Content="Switch"
                    Click="OnBrowse"
                    IsEnabled="{x:Bind ViewModel.CanNavigate, Mode=OneWay}" />
            <!-- Icon-only: a fifth worded button does not fit at 320px. Always enabled,
                 because reconnecting is exactly what you want when nothing else works. -->
            <Button Content="&#xE72C;"
                    FontFamily="Segoe MDL2 Assets"
                    Click="OnReload"
                    ToolTipService.ToolTip="Reconnect to Discord" />
        </StackPanel>

        <!-- Picker overlay. Covers the whole widget rather than sitting alongside: at
             320px wide there is no room for both, and the list can run to dozens of rows. -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Visibility="{x:Bind Visible(ViewModel.IsBrowsing), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="&#xE72B;"
                        FontFamily="Segoe MDL2 Assets"
                        Padding="8,4"
                        Click="OnCancelBrowse"
                        ToolTipService.ToolTip="Back" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.PickerTitle, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <ProgressRing Grid.Row="1"
                          IsActive="{x:Bind ViewModel.IsPickerBusy, Mode=OneWay}"
                          Visibility="{x:Bind Visible(ViewModel.IsPickerBusy), Mode=OneWay}"
                          Width="28" Height="28"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Center" />

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.PickerItems}"
                      IsItemClickEnabled="True"
                      ItemClick="OnPickerItemClick"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="34" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PickerItem">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
