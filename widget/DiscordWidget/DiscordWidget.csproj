<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{6F3D9A21-4C7E-4B2A-9E51-8B0C7D5A1E44}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>DiscordWidget</RootNamespace>
    <AssemblyName>DiscordWidget</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <!-- Game Bar widgets require Windows 10 1903 (18362) or later. -->
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <EnableDotNetNativeCompatibleProfile>true</EnableDotNetNativeCompatibleProfile>
    <LangVersion>latest</LangVersion>
    <!-- Signing is off so the project builds from the command line without a certificate.
         Visual Studio will offer to create a temporary key the first time you deploy. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <NoWarn>;2008</NoWarn>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='x86'">
    <OutputPath>bin\x86\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x86\$(Configuration)\</IntermediateOutputPath>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='ARM64'">
    <OutputPath>bin\ARM64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\ARM64\$(Configuration)\</IntermediateOutputPath>
    <PlatformTarget>ARM64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="VoiceWidget.xaml.cs">
      <DependentUpon>VoiceWidget.xaml</DependentUpon>
    </Compile>
    <Compile Include="AppServiceSession.cs" />
    <Compile Include="WidgetLog.cs" />
    <Compile Include="WidgetViewModel.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="VoiceWidget.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Properties\Default.rd.xml" />
    <Content Include="Assets\**\*.png" />
    <Content Include="GameBar\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Gaming.XboxGameBar">
      <Version>7.3.2607010</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Discord.Rpc\Discord.Rpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplies FullTrustProcessLauncher, which is not part of the base UWP surface. -->
    <SDKReference Include="WindowsDesktop, Version=10.0.26100.0">
      <Name>Windows Desktop Extensions for the UWP</Name>
    </SDKReference>
  </ItemGroup>

  <!-- Package the full-trust bridge under bridge\, matching the Executable path declared
       on the windows.fullTrustProcess extension. Built via a project reference would pull
       a net9.0 assembly into a UWP reference graph, so it is consumed as content instead
       and ordered with a solution-level build dependency. -->
  <PropertyGroup>
    <BridgeOutputDir>$(MSBuildThisFileDirectory)..\..\src\Discord.Rpc.Bridge\bin\$(Configuration)\net9.0-windows10.0.19041.0\win-x64\</BridgeOutputDir>
  </PropertyGroup>

  <Target Name="IncludeBridgePayload" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <BridgeFile Include="$(BridgeOutputDir)**\*.*"
                  Exclude="$(BridgeOutputDir)**\*.pdb;$(BridgeOutputDir)**\*.xml" />
      <Content Include="@(BridgeFile)">
        <Link>bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <Warning Condition="'@(BridgeFile)' == ''"
             Text="Bridge output not found at $(BridgeOutputDir). Build Discord.Rpc.Bridge first or the widget will package without its full-trust component." />
  </Target>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
