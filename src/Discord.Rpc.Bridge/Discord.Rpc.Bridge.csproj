<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so Game Bar launching the bridge does not flash a console window.
         Self-test mode attaches to the parent console explicitly. -->
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM for the WinRT projections: AppServiceConnection lives there. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Discord.Rpc.Bridge</RootNamespace>
    <AssemblyName>Discord.Rpc.Bridge</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Must match the widget's architecture to be packaged alongside it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Discord.Rpc\Discord.Rpc.csproj" />
  </ItemGroup>

</Project>
