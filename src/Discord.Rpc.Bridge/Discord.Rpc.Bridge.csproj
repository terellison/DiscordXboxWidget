<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so Game Bar launching the bridge does not flash a console window.
         Self-test mode attaches to the parent console explicitly. -->
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM for the WinRT projections: AppServiceConnection lives there. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Discord.Rpc.Bridge</RootNamespace>
    <AssemblyName>Discord.Rpc.Bridge</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Must match the widget's architecture to be packaged alongside it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained because the package is sideloaded: there is no Store to resolve a
         shared runtime from, and the widget cannot report a missing one usefully: a
         framework-dependent bridge that finds no .NET runtime simply fails to start, which
         surfaces as the widget stuck on "Connecting". It is also what the packaging project
         imposes on .NETCoreApp references anyway, so declaring it here keeps a direct
         `dotnet build` and a packaged build producing the same thing, and makes restore
         fetch the runtime pack that publish needs. -->
    <SelfContained>true</SelfContained>
    <!-- Pinned explicitly so the path does not gain an extra x64\ segment when built as
         part of the solution with Platform=x64. -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Discord.Rpc\Discord.Rpc.csproj" />
  </ItemGroup>

</Project>
